Buildin_Resource :: struct {
	pipeline:    struct {
		default_h:   Render_Pipeline_Handle,
		primitive_h: Render_Pipeline_Handle,
		text_h:      Render_Pipeline_Handle,
	},
	square:      Model, // TODO: depricated
	unit_square: Mesh,
