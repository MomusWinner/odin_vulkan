	Host_Read,
	Host_Write,
}

Buffer :: struct {
	buffer:     vk.Buffer,
	vk_usage:   vk.BufferUsageFlags,
	usage:      Buffer_Usage_Flags,
	mapped:     rawptr,
	size:       Device_Size,
	alloc:      vma.Allocation,
	alloc_info: vma.AllocationInfo,
}

Uniform_Buffer_Handle :: distinct hm.Handle
