Graphics_Limits :: struct {
	max_sample_count:       Sample_Count_Flag,
	max_sampler_anisotropy: f32,
}

Graphics_Attachment_Flags :: distinct bit_set[Graphics_Attachment_Flag]
Graphics_Attachment_Flag :: enum {
	Depth,
	Stencil,
}

Graphics_Init_Info :: struct {
	swapchain_sample_count: Sample_Count_Flag,
	attachments:            Graphics_Attachment_Flags,
}

Swapchain_Configuration :: struct {
	present_mode:         vk.PresentModeKHR,
	depth_format:         vk.Format,
